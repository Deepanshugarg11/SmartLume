    {
        "id": "2d4b78a814092e0e",
        "type": "function",
        "z": "4f29fe90d9f287b6",
        "name": "SmartLume Lighting Rule",
        "func": "let reading = msg.payload;\n\n// Convert JSON string into an object if required\nif (typeof reading === \"string\") {\n    reading = JSON.parse(reading);\n}\n\n// SmartLume lighting rule\nif (reading.motion_detected && reading.ambient_lux < 200) {\n    reading.brightness_pct = 100;\n} \nelse if (reading.motion_detected && reading.ambient_lux >= 200) {\n    reading.brightness_pct = 70;\n} \nelse if (!reading.motion_detected && reading.ambient_lux < 200) {\n    reading.brightness_pct = 30;\n} \nelse {\n    reading.brightness_pct = 0;\n}\n\n// Estimate power consumption\nreading.power_watts = Number(\n    (reading.brightness_pct * 0.5).toFixed(2)\n);\n\nmsg.payload = reading;\n\nreturn msg;",
